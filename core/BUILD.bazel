load("@rules_java//java:java_binary.bzl", "java_binary")
load("@rules_java//java:java_import.bzl", "java_import")
load("@rules_java//java:java_library.bzl", "java_library")
load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library", "kt_jvm_test")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

MAIN = "src/main/kotlin/ca/joelathiessen/"

TESTS = "src/test/kotlin/ca/joelathiessen/kaly2/core/tests/pc/"

java_import(
    name = "ev3classes",
    jars = ["lib/leJOS_EV3_0.9.1-beta/lib/ev3/ev3classes.jar"],
)

# Exposed 0.8.6 was only published on Bintray, which shut down in 2021. Fetch it
# from the project's private Maven repo into lib/ (kept out of git) before building.
java_import(
    name = "exposed",
    jars = ["lib/exposed-0.8.6.jar"],
    deps = [
        "@maven//:joda_time_joda_time",
        "@maven//:org_slf4j_slf4j_api",
        "@rules_kotlin//kotlin/compiler:kotlin-reflect",
    ],
)

java_library(
    name = "kdtree",
    srcs = glob(["src/main/java/ags/**/*.java"]),
)

# Most of the packages use each other, so all of the Kotlin compiles as one library
kt_jvm_library(
    name = "core",
    srcs = glob([MAIN + "**/*.kt"]),
    resource_strip_prefix = "core/src/main/resources",
    resources = glob(["src/main/resources/**"]),
    runtime_deps = [
        "@maven//:com_h2database_h2",
        "@maven//:mysql_mysql_connector_java",
    ],
    deps = [
        ":ev3classes",
        ":exposed",
        ":kdtree",
        "@maven//:com_github_salomonbrys_kotson_kotson",
        "@maven//:com_google_code_gson_gson",
        "@maven//:gov_nist_math_jama",
        "@maven//:joda_time_joda_time",
        "@maven//:org_eclipse_jetty_jetty_continuation",
        "@maven//:org_eclipse_jetty_jetty_http",
        "@maven//:org_eclipse_jetty_jetty_io",
        "@maven//:org_eclipse_jetty_jetty_security",
        "@maven//:org_eclipse_jetty_jetty_server",
        "@maven//:org_eclipse_jetty_jetty_servlet",
        "@maven//:org_eclipse_jetty_jetty_util",
        "@maven//:org_eclipse_jetty_jetty_webapp",
        "@maven//:org_eclipse_jetty_jetty_websocket",
        "@maven//:org_eclipse_jetty_jetty_xml",
    ],
)

# bazel run //core:server, or build //core:server_deploy.jar for a single runnable jar
java_binary(
    name = "server",
    main_class = "ca.joelathiessen.kaly2.core.server.KalyServer",
    runtime_deps = [":core"],
)

pkg_tar(
    name = "server_layer",
    files = {":server_deploy.jar": "app/kaly2.jar"},
)

oci_image(
    name = "image",
    # base = "@eclipse_temurin_8_jre_linux_amd64",
    base = "@eclipse_temurin_25_jre_linux_amd64",
    cmd = [
        "java",
        # Java 8's CMS collector, which Java 14 removed. The pause settings were tuned for it
        # "-XX:+UseConcMarkSweepGC",
        # "-XX:CMSIncrementalSafetyFactor=50",
        # "-XX:+UseParNewGC",
        # "-XX:+CMSConcurrentMTEnabled",
        # "-XX:ConcGCThreads=2",
        # "-XX:ParallelGCThreads=2",
        # "-XX:GCTimeRatio=90",
        # "-XX:MaxGCPauseMillis=1",
        # "-XX:GCPauseIntervalMillis=1000",
        # Of Java 25's collectors, Parallel ran the demo fastest on Cloud Run's 2 CPUs: about
        # 39 steps a second once warmed up, against 37 for Serial (its default there) and 27 for ZGC
        "-XX:+UseParallelGC",
        # With Cloud Run's 1 GiB, Java starts with a 16 MB heap. On Java 8 with the settings
        # above it stayed that small, and collecting garbage took about half of kaly2's CPU.
        # 256 MB is the most Java would allow itself anyway
        "-Xms256m",
        "-jar",
        "kaly2.jar",
    ],
    exposed_ports = ["9000/tcp"],
    tars = [":server_layer"],
    workdir = "/app",
)

# bazel run //core:image_load puts the image into Docker as kaly2:local
oci_load(
    name = "image_load",
    image = ":image",
    repo_tags = ["kaly2:local"],
)

# Tests

kt_jvm_library(
    name = "test_util",
    testonly = True,
    srcs = [
        TESTS + "unit/util/TestUtil.kt",
        TESTS + "unit/util/itractor/ItrActorSampleImpl.kt",
    ],
    deps = [":core"],
)

TEST_DEPS = [
    ":core",
    ":ev3classes",
    ":exposed",
    ":kdtree",
    ":test_util",
    "@maven//:com_google_code_gson_gson",
    "@maven//:com_nhaarman_mockito_kotlin",
    "@maven//:gov_nist_math_jama",
    "@maven//:junit_junit",
    "@maven//:org_mockito_mockito_core",
]

# These declare the subconscious test package although they sit in other folders
WRONG_PACKAGE = {
    "GlobalMapTest": "ca.joelathiessen.kaly2.core.tests.pc.unit.subconscious",
    "GlobalPathPlannerTest": "ca.joelathiessen.kaly2.core.tests.pc.unit.subconscious",
    "LinearPathSegmentTest": "ca.joelathiessen.kaly2.core.tests.pc.unit.subconscious",
}

# One target per test class, e.g. bazel test //core:RobotTest
[kt_jvm_test(
    name = name,
    srcs = [src],
    resource_strip_prefix = "core/src/test/resources",
    # Mocks final Kotlin classes
    resources = ["src/test/resources/mockito-extensions/org.mockito.plugins.MockMaker"],
    test_class = WRONG_PACKAGE.get(name, folder.replace("/", ".")) + "." + name,
    deps = TEST_DEPS,
) for src in glob([TESTS + "**/*Test.kt"]) for folder, name in [(
    src[len("src/test/kotlin/"):].rpartition("/")[0],
    src.split("/")[-1][:-len(".kt")],
)]]

# The Swing demos, e.g. bazel run //core:MainLoopDemo
kt_jvm_library(
    name = "demos",
    testonly = True,
    srcs = glob([TESTS + "acceptance/*.kt"]),
    resource_strip_prefix = "core/src/test/resources",
    resources = glob(["src/test/resources/images/*"]),
    deps = TEST_DEPS,
)

[java_binary(
    name = demo,
    testonly = True,
    main_class = "ca.joelathiessen.kaly2.core.tests.pc.acceptance." + demo,
    runtime_deps = [":demos"],
) for demo in [
    "FastSLAMDemo",
    "FeatureDetectorDemo",
    "MainLoopDemo",
    "RRTStarDemo",
]]

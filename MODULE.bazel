module(name = "kaly2")

bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_jvm_external", version = "7.1")
bazel_dep(name = "rules_kotlin", version = "2.4.20")
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "com.github.salomonbrys.kotson:kotson:2.3.0",
        "com.h2database:h2:1.4.196",
        "gov.nist.math:jama:1.0.3",
        "mysql:mysql-connector-java:5.1.6",
        # The Jetty 7 release core/build.gradle uses (Jetty 8+ doesn't work on Android)
        "org.eclipse.jetty:jetty-continuation:7.5.4.v20111024",
        "org.eclipse.jetty:jetty-http:7.5.4.v20111024",
        "org.eclipse.jetty:jetty-io:7.5.4.v20111024",
        "org.eclipse.jetty:jetty-security:7.5.4.v20111024",
        "org.eclipse.jetty:jetty-server:7.5.4.v20111024",
        "org.eclipse.jetty:jetty-servlet:7.5.4.v20111024",
        "org.eclipse.jetty:jetty-util:7.5.4.v20111024",
        "org.eclipse.jetty:jetty-webapp:7.5.4.v20111024",
        "org.eclipse.jetty:jetty-websocket:7.5.4.v20111024",
        "org.eclipse.jetty:jetty-xml:7.5.4.v20111024",
        # Exposed 0.8.6's own dependencies; its jar is core/lib/exposed-0.8.6.jar
        "joda-time:joda-time:2.9.9",
        "org.slf4j:slf4j-api:1.7.25",
        # Tests
        "com.nhaarman:mockito-kotlin:1.5.0",
        "junit:junit:4.12",
        "org.mockito:mockito-core:2.8.9",
    ],
    # Exact versions and checksums of every jar; refresh with: bazel run @maven//:pin
    lock_file = "//:maven_install.json",
    # The Kotlin standard library comes from the Kotlin rules, matching the compiler
    excluded_artifacts = [
        "org.jetbrains.kotlin:kotlin-reflect",
        "org.jetbrains.kotlin:kotlin-runtime",
        "org.jetbrains.kotlin:kotlin-stdlib",
    ],
    # protobuf (used by the Kotlin rules) adds its own libraries to this list
    known_contributing_modules = ["protobuf"],
    repositories = ["https://repo1.maven.org/maven2"],
)

# Other modules (protobuf) add a newer Gson to the same list; keep the one the server was built with
maven.artifact(
    artifact = "gson",
    force_version = True,
    group = "com.google.code.gson",
    version = "2.7",
)
use_repo(maven, "maven")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# The same Java 8 runtime the image used before Bazel
oci.pull(
    name = "eclipse_temurin_8_jre",
    digest = "sha256:8d9e089742fa5f8f31e0dcce21b9b108083b154a53dce8f61845fe006b21c0bb",
    image = "docker.io/library/eclipse-temurin",
    platforms = ["linux/amd64"],
    tag = "8-jre-alpine",
)
use_repo(oci, "eclipse_temurin_8_jre", "eclipse_temurin_8_jre_linux_amd64")
